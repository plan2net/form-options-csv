{
  "name" : "plan2net/form-options-csv",
  "description" : "Import CSV data for Core form extension select options",
  "require" : {
    "php" : "^8.2",
    "typo3/cms-core" : "^12.4 || ^13.4 || ^14.3",
    "typo3/cms-form" : "^12.4 || ^13.4 || ^14.3"
  },
  "require-dev" : {
    "typo3/testing-framework" : "^8.2 || ^9.0",
    "typo3/coding-standards": "^0.9.0",
    "phpstan/phpstan": "^2.3",
    "saschaegerer/phpstan-typo3": "^2.1 || ^3.1"
  },
  "type" : "typo3-cms-extension",
  "autoload" : {
    "psr-4" : {
      "Plan2net\\FormOptionsCsv\\" : "Classes"
    }
  },
  "autoload-dev" : {
    "psr-4" : {
      "Plan2net\\FormOptionsCsv\\Tests\\" : "Tests"
    }
  },
  "config" : {
    "allow-plugins" : {
      "typo3/class-alias-loader" : true,
      "typo3/cms-composer-installers" : true
    }
  },
  "scripts" : {
    "test" : "phpunit",
    "php-cs-fixer" : "php-cs-fixer fix --dry-run --diff --config=php-cs-fixer.config.php",
    "php-cs-fixer:fix" : "php-cs-fixer fix --config=php-cs-fixer.config.php",
    "phpstan" : "phpstan analyse --no-progress",
    "qa" : ["@php-cs-fixer", "@phpstan", "@test"],
    "qa:fix" : ["@php-cs-fixer:fix", "@phpstan", "@test"]
  },
  "extra" : {
    "typo3/cms" : {
      "extension-key" : "form_options_csv",
      "web-dir" : ".Build/public"
    }
  }
}
