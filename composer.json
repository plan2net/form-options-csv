{
  "name" : "plan2net/form-options-csv",
  "description" : "Import options for TYPO3 form select fields from a spreadsheet or CSV file",
  "require" : {
    "php" : "^8.2",
    "typo3/cms-core" : "^12.4 || ^13.4 || ^14.3",
    "typo3/cms-form" : "^12.4 || ^13.4 || ^14.3"
  },
  "require-dev" : {
    "typo3/coding-standards": "^0.9.0"
  },
  "type" : "typo3-cms-extension",
  "config" : {
    "allow-plugins" : {
      "typo3/class-alias-loader" : true,
      "typo3/cms-composer-installers" : true
    }
  },
  "scripts" : {
    "php-cs-fixer" : "php-cs-fixer fix --dry-run --diff --config=php-cs-fixer.config.php",
    "php-cs-fixer:fix" : "php-cs-fixer fix --config=php-cs-fixer.config.php",
    "qa" : ["@php-cs-fixer"],
    "qa:fix" : ["@php-cs-fixer:fix"]
  },
  "extra" : {
    "typo3/cms" : {
      "extension-key" : "form_options_csv",
      "web-dir" : ".Build/public"
    }
  }
}
