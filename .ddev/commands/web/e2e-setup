#!/usr/bin/env bash

## Description: Build a TYPO3 test site in .Build/v<version> and install Playwright for the end-to-end tests
## Usage: e2e-setup [12|13|14]
## Example: ddev e2e-setup 12

set -euo pipefail
cd "$DDEV_APPROOT"

version="${1:-14}"
case "$version" in
    12) constraint="^12.4" ;;
    13) constraint="^13.4" ;;
    14) constraint="^14.3" ;;
    *) echo "Unknown TYPO3 version: $version (use 12, 13 or 14)" >&2; exit 1 ;;
esac
site=".Build/v$version"

if [ ! -d "$site" ]; then
    trap 'rm -rf "$site"' ERR
    composer create-project --no-interaction --no-progress --no-install "typo3/cms-base-distribution:$constraint" "$site"
    if [ "$version" = "12" ]; then
        # Free 12.4 releases carry advisories that are only fixed in paid ELTS releases.
        composer --working-dir="$site" config policy.advisories.block false
    fi
    composer --working-dir="$site" config --unset platform.php
    composer --working-dir="$site" config repositories.local '{"type": "path", "url": "../../", "options": {"symlink": true}}'
    composer --working-dir="$site" require --no-progress "plan2net/form-options-csv:@dev"
    "$site/vendor/bin/typo3" setup --no-interaction --driver=sqlite \
        --admin-username=admin --admin-user-password='Password-1234!' --admin-email=admin@example.com \
        --project-name='Form options CSV' --create-site="${DDEV_PRIMARY_URL}/" --server-type=apache
    cat > "$site/config/system/additional.php" <<'PHP'
<?php

$GLOBALS['TYPO3_CONF_VARS']['SYS']['displayErrors'] = 1;
$GLOBALS['TYPO3_CONF_VARS']['SYS']['devIPmask'] = '*';
$GLOBALS['TYPO3_CONF_VARS']['SYS']['trustedHostsPattern'] = '.*';
PHP
    trap - ERR
fi

npm install --no-audit --no-fund
npx playwright install --with-deps chromium
